diff --git a/progetti/gestionale-php/src/Report/ReportTicketAperti.php b/progetti/gestionale-php/src/Report/ReportTicketAperti.php
new file mode 100644
index 0000000..30f586e
--- /dev/null
+++ b/progetti/gestionale-php/src/Report/ReportTicketAperti.php
@@ -0,0 +1,124 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CiaspoLink\Gestionale\Report;
+
+use DateTimeImmutable;
+use Exception;
+use PDO;
+use RuntimeException;
+
+/**
+ * I ticket aperti, dal più vecchio, con le ore passate dall'apertura: il file
+ * CSV che il NOC apre all'inizio di ogni turno.
+ */
+final class ReportTicketAperti
+{
+    private const INTESTAZIONE = [
+        'ticket', 'apparato', 'priorita', 'stato', 'oggetto', 'aperto_il', 'ore_da_apertura', 'urgente', 'esportato_il',
+    ];
+
+    public function __construct(private readonly PDO $pdo)
+    {
+    }
+
+    /**
+     * @return list<RigaTicketAperto>
+     */
+    public function righe(?string $apparato = null): array
+    {
+        $stmt = $this->pdo->prepare(<<<'SQL'
+            SELECT id, apparato_id, priorita, stato, oggetto, aperto_il
+              FROM ticket
+             WHERE stato NOT IN ('risolto', 'chiuso')
+               AND (:apparato IS NULL OR apparato_id = :apparato)
+             ORDER BY aperto_il, id
+            SQL);
+        $stmt->execute(['apparato' => $apparato]);
+
+        return array_map(RigaTicketAperto::daRiga(...), $stmt->fetchAll());
+    }
+
+    /**
+     * @return int quanti ticket ha esportato
+     *
+     * @throws RuntimeException se il file non si può scrivere
+     */
+    public function esporta(string $fileCsv, DateTimeImmutable $adesso, ?string $apparato = null): int
+    {
+        if (!is_writable(dirname($fileCsv))) {
+            throw new RuntimeException('Impossibile scrivere ' . $fileCsv);
+        }
+        $tktAperti = $this->righe($apparato);
+        $file = fopen($fileCsv, 'wb');
+        if ($file === false) {
+            throw new RuntimeException('Impossibile scrivere ' . $fileCsv);
+        }
+        try {
+            fputcsv($file, self::INTESTAZIONE, ';', '"', '');
+            foreach ($tktAperti as $tkt) {
+                fputcsv($file, [
+                    $tkt->id,
+                    $tkt->apparatoId,
+                    $tkt->priorita,
+                    $tkt->stato,
+                    $tkt->oggetto,
+                    $tkt->apertoIl,
+                    $tkt->oreDaApertura($adesso),
+                    $tkt->isUrgente() ? 'si' : 'no',
+                    $adesso->format('Y-m-d H:i:s'),
+                ], ';', '"', '');
+            }
+        } finally {
+            fclose($file);
+        }
+
+        return count($tktAperti);
+    }
+}
+
+final class RigaTicketAperto
+{
+    public function __construct(
+        public readonly string $id,
+        public readonly ?string $apparatoId,
+        public readonly string $priorita,
+        public readonly string $stato,
+        public readonly string $oggetto,
+        public readonly string $apertoIl,
+    ) {
+    }
+
+    /**
+     * @param array<string, mixed> $riga riga di ticket
+     */
+    public static function daRiga(array $riga): self
+    {
+        return new self(
+            (string) $riga['id'],
+            $riga['apparato_id'] === null ? null : (string) $riga['apparato_id'],
+            (string) $riga['priorita'],
+            (string) $riga['stato'],
+            (string) $riga['oggetto'],
+            (string) $riga['aperto_il'],
+        );
+    }
+
+    public function isUrgente(): bool
+    {
+        return $this->priorita === 'critica' || $this->priorita === 'alta';
+    }
+
+    public function oreDaApertura(DateTimeImmutable $adesso): int
+    {
+        $ore = 0;
+        try {
+            $aperto = new DateTimeImmutable($this->apertoIl);
+            $ore = (int) floor(($adesso->getTimestamp() - $aperto->getTimestamp()) / 3600);
+        } catch (Exception $errore) {
+        }
+
+        return $ore;
+    }
+}
diff --git a/progetti/gestionale-php/tests/Integrazione/ReportTicketApertiTest.php b/progetti/gestionale-php/tests/Integrazione/ReportTicketApertiTest.php
