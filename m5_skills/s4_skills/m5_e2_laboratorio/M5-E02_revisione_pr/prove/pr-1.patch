+<?php
+
+declare(strict_types=1);
+
+/*
+ * Esporta in CSV i ticket aperti, per il NOC: tutti, o quelli di un apparato.
+ *
+ * Uso: php bin/export_ticket.php [--apparato=id] [--uscita=file.csv] [--db=percorso]
+ */
+
+use CiaspoLink\Gestionale\Applicazione;
+
+require __DIR__ . '/../vendor/autoload.php';
+
+$opzioni = getopt('', ['apparato:', 'uscita:', 'db:']);
+$applicazione = Applicazione::avvia(isset($opzioni['db']) ? ['db_path' => (string) $opzioni['db']] : []);
+
+$apparato = isset($opzioni['apparato']) ? (string) $opzioni['apparato'] : null;
+if ($apparato !== null) {
+    $stmt = $applicazione->pdo()->prepare('SELECT COUNT(*) FROM apparati WHERE id = :id');
+    $stmt->execute(['id' => $apparato]);
+    if ((int) $stmt->fetchColumn() === 0) {
+        echo "Apparato sconosciuto: {$apparato}\n";
+        exit(1);
+    }
+}
+
+$adesso = new DateTimeImmutable();
+$uscita = (string) ($opzioni['uscita'] ?? $applicazione->cartellaEsportazioni() . '/ticket-aperti.csv');
+$cartella = dirname($uscita);
+if (!is_dir($cartella) && !mkdir($cartella, 0775, true)) {
+    echo "Impossibile creare la cartella {$cartella}\n";
+    exit(1);
+}
+
+try {
+    $quanti = $applicazione->reportTicketAperti()->esporta($uscita, $adesso, $apparato);
+} catch (RuntimeException $errore) {
+    echo 'Esportazione non eseguita: ' . $errore->getMessage() . "\n";
+    exit(1);
+}
+echo "{$quanti} ticket aperti esportati in {$uscita}\n";
+exit(0);
