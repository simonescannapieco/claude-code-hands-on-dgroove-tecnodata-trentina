@@ -0,0 +1,46 @@
+<?php
+
+declare(strict_types=1);
+
+namespace CiaspoLink\Gestionale\Tests\Integrazione;
+
+use CiaspoLink\Gestionale\Report\ReportTicketAperti;
+use CiaspoLink\Gestionale\Tests\Support\DatabaseDiProva;
+use DateTimeImmutable;
+use PHPUnit\Framework\TestCase;
+
+final class ReportTicketApertiTest extends TestCase
+{
+    private ReportTicketAperti $report;
+
+    protected function setUp(): void
+    {
+        $this->report = new ReportTicketAperti(DatabaseDiProva::conDati());
+    }
+
+    public function testReport(): void
+    {
+        $righe = $this->report->righe();
+
+        self::assertNotEmpty($righe);
+        foreach ($righe as $riga) {
+            self::assertNotContains($riga->stato, ['risolto', 'chiuso']);
+        }
+    }
+
+    public function testApparato(): void
+    {
+        self::assertSame([], $this->report->righe('olt-inesistente-99'));
+    }
+
+    public function testCsv(): void
+    {
+        $file = tempnam(sys_get_temp_dir(), 'ticket-');
+        self::assertIsString($file);
+
+        $quanti = $this->report->esporta($file, new DateTimeImmutable('2026-09-14T08:00:00+02:00'));
+
+        self::assertCount($quanti + 1, (array) file($file));
+        unlink($file);
+    }
+}
