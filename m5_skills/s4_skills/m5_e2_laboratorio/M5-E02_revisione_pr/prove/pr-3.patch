+// clienti con almeno una fattura scaduta: quante e per quanto
+function clienti_morosi()
+{
+    return db_fetch_all(db_query("SELECT c.*, COUNT(*) AS fatture, SUM(f.totale_cent) AS totale_cent
+                                  FROM fatture f JOIN clienti c ON c.id = f.cliente_id
+                                  WHERE f.stato = 'scaduta' AND f.tipo = 'fattura'
+                                  GROUP BY c.id ORDER BY c.id"));
+}
