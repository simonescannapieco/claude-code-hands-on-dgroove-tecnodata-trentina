{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(tools/php.sh php progetti/gestionale-php/vendor/bin/phpunit *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(/tools/php.sh)"
    ]
  }
}
