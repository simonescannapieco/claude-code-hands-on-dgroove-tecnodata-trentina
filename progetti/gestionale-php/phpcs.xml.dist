<?xml version="1.0"?>
<ruleset name="CiaspoLink">
    <description>PSR-12 sul codice nuovo; legacy/ e templates/ sono esclusi (vedi docs/convenzioni.md).</description>
    <file>bin</file>
    <file>config</file>
    <file>public/index.php</file>
    <file>src</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
